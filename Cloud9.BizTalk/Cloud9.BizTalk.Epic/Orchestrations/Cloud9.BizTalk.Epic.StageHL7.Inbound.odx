                                <om:Property Name="Expression" Value="if (System.String.IsNullOrWhiteSpace(strPracticeID) == true)&#xD;&#xA;{&#xD;&#xA;    strErrorMessage = System.String.Format(&quot;{0}: Practice Not Provided.&quot;, strOrchestrationName );&#xD;&#xA;}&#xD;&#xA;else&#xD;&#xA;{&#xD;&#xA;    strErrorMessage = System.String.Format(&quot;{0}: Practice ID not a valid GUID&lt;{1}&gt;.&quot;, strOrchestrationName, strPracticeID);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;System.Diagnostics.EventLog.WriteEntry(strMessageSource, strErrorMessage, System.Diagnostics.EventLogEntryType.Error);" />
