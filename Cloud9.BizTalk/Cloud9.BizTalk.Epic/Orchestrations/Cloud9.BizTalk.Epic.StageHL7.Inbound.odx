                        <om:Property Name="Expression" Value="strOrchestrationName = &quot;StageHL7_Inbound&quot;;&#xD;&#xA;&#xD;&#xA;strPracticeID = xpath(msgHeader, &quot;string(/*[local-name()='MSH_25_GLO_DEF' and namespace-uri()='http://microsoft.com/HealthCare/HL7/2X']/*[local-name()='MSH' and namespace-uri()='']/*[local-name()='MSH.6_ReceivingFacility' and namespace-uri()='']/*[local-name()='HD.0_NamespaceId' and namespace-uri()=''])&quot;);&#xD;&#xA;&#xD;&#xA;bValidGUID = System.Guid.TryParse(strPracticeID, out practiceGUID );&#xD;&#xA;" />
