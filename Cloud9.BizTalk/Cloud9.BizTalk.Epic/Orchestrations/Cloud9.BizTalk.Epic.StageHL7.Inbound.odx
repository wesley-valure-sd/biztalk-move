                                    <om:Property Name="Expression" Value="Cloud9.BizTalk.Helper.Conversion.SetXMLNode(msgStagingInsertReq.Body, &quot;/*[local-name()='Insert' and namespace-uri()='http://schemas.microsoft.com/Sql/2008/05/TableOp/BTS/HL7InboundStaging']/*[local-name()='Rows' and namespace-uri()='http://schemas.microsoft.com/Sql/2008/05/TableOp/BTS/HL7InboundStaging']/*[local-name()='HL7InboundStaging' and namespace-uri()='http://schemas.microsoft.com/Sql/2008/05/Types/Tables/BTS']/*[local-name()='hisMessageData' and namespace-uri()='http://schemas.microsoft.com/Sql/2008/05/Types/Tables/BTS']&quot;, strMsgData);&#xD;&#xA;&#xD;&#xA;msgStagingInsertReq(WCF.Action)=&quot;TableOp/Insert/BTS/HL7InboundStaging&quot;;  &#xD;&#xA;msgStagingInsertReq(WCF.BindingType)=&quot;sqlBinding&quot;;&#xD;&#xA;msgStagingInsertReq(BTS.RetryCount) = 0;&#xD;&#xA;msgStagingInsertReq(BTS.RetryInterval) = 1; //(in minutes)&#xD;&#xA;" />
