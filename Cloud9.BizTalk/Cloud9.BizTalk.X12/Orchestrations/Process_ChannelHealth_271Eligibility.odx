                    <om:Element Type="VariableAssignment" OID="b01c2912-0b77-4282-bd5c-873f0f303682" ParentLink="ComplexStatement_Statement" LowerBound="68.1" HigherBound="93.1">
                        <om:Property Name="Expression" Value="// Channel Health will use a file naming convention, not a folder naming convention&#xD;&#xA;// PRACTICENAME_BlahBlahBlah.*&#xD;&#xA;&#xD;&#xA;strTransportType = ChannelHealth271(BTS.InboundTransportType);&#xD;&#xA;&#xD;&#xA;if (strTransportType == &quot;SFTP&quot;)&#xD;&#xA;{&#xD;&#xA;    strFileName = ChannelHealth271(SFTP.ReceivedFileName);&#xD;&#xA;    strFileName = strFileName.Substring(strFileName.LastIndexOf(&quot;/&quot;) + 1);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;if (strTransportType == &quot;FTP&quot;)&#xD;&#xA;{&#xD;&#xA;    strFileName = ChannelHealth271(FTP.ReceivedFileName);&#xD;&#xA;    strFileName = strFileName.Substring(strFileName.LastIndexOf(&quot;/&quot;) + 1);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;if (strTransportType == &quot;FILE&quot;)&#xD;&#xA;{&#xD;&#xA;    strFileName = ChannelHealth271(FILE.ReceivedFileName);&#xD;&#xA;    strFileName = strFileName.Substring(strFileName.LastIndexOf(&quot;\\&quot;) + 1);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;strPracticeName = strFileName.Substring(0, strFileName.IndexOf('_'));&#xD;&#xA;" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="Get Practice Name" />
                        <om:Property Name="Signal" Value="False" />
                    </om:Element>
