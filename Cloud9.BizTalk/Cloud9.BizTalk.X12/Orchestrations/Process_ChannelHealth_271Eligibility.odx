                            <om:Property Name="Expression" Value="xmlDoc = new System.Xml.XmlDocument();&#xD;&#xA;&#xD;&#xA;xmlDoc.LoadXml( System.String.Format(&quot;&lt;ns0:GetPracticeConfigurationByName xmlns:ns0=\&quot;http://schemas.microsoft.com/Sql/2008/05/TypedProcedures/BTS\&quot;&gt;&lt;ns0:pcName&gt;{0}&lt;/ns0:pcName&gt;&lt;/ns0:GetPracticeConfigurationByName&gt;&quot;, strPracticeName ) );&#xD;&#xA;&#xD;&#xA;GetPracticeConfigurationByName.Body = xmlDoc ;" />
