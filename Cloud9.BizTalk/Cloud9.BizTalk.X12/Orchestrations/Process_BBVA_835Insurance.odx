                        <om:Property Name="Expression" Value="strTransportType = BBVA835(BTS.InboundTransportType);&#xD;&#xA;strTransportLocation = BBVA835(BTS.InboundTransportLocation);&#xD;&#xA;&#xD;&#xA;if (strTransportType == &quot;SFTP&quot; || strTransportType == &quot;FTP&quot;)&#xD;&#xA;{&#xD;&#xA;    strPracticeName = strTransportLocation.Substring(0, strTransportLocation.LastIndexOf(&quot;/&quot;));&#xD;&#xA;    strPracticeName = strPracticeName.Substring(strPracticeName.LastIndexOf(&quot;/&quot;) + 1);&#xD;&#xA;}&#xD;&#xA;if (strTransportType == &quot;FILE&quot;)&#xD;&#xA;{&#xD;&#xA;    strPracticeName = strTransportLocation.Substring(0, strTransportLocation.LastIndexOf(&quot;\\&quot;));&#xD;&#xA;    strPracticeName = strPracticeName.Substring(strPracticeName.LastIndexOf(&quot;\\&quot;) + 1);&#xD;&#xA;}" />
