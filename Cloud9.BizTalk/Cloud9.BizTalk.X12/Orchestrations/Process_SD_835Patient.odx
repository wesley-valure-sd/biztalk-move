                    <om:Element Type="VariableAssignment" OID="00570b0a-7540-4add-b293-55fb110f6645" ParentLink="ComplexStatement_Statement" LowerBound="65.1" HigherBound="87.1">
                        <om:Property Name="Expression" Value="strTransportType = SD_835(BTS.InboundTransportType);&#xD;&#xA;strTransportLocation = SD_835(BTS.InboundTransportLocation);&#xD;&#xA;strFileName = SD_835(FILE.ReceivedFileName);&#xD;&#xA;&#xD;&#xA;if (strTransportType == &quot;SFTP&quot; || strTransportType == &quot;FTP&quot;)&#xD;&#xA;{&#xD;&#xA;    strPracticeName = strTransportLocation.Substring(0, strTransportLocation.LastIndexOf(&quot;/&quot;));&#xD;&#xA;    strPracticeName = strPracticeName.Substring(strPracticeName.LastIndexOf(&quot;/&quot;) + 1);&#xD;&#xA;    strFileName = strFileName.Substring(strFileName.LastIndexOf(&quot;/&quot;) + 1);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;if (strTransportType == &quot;FILE&quot;)&#xD;&#xA;{&#xD;&#xA;    strPracticeName = strTransportLocation.Substring(0, strTransportLocation.LastIndexOf(&quot;\\&quot;));&#xD;&#xA;    strPracticeName = strPracticeName.Substring(strPracticeName.LastIndexOf(&quot;\\&quot;) + 1);&#xD;&#xA;    strFileName = strFileName.Substring(strFileName.LastIndexOf(&quot;\\&quot;) + 1);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;ReceiveLocationName = Cloud9.BizTalk.Helper.XLangMessageHelpers.GetReceiveLocationName(SD_835);&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
