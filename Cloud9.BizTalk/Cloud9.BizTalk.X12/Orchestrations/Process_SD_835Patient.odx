                        <om:Property Name="Expression" Value="ClaimPaymentCount = System.Convert.ToInt32(xpath(ClaimPaymentBatch, &quot;count(//*[local-name()='ClaimPayment'])&quot;));&#xD;&#xA;&#xD;&#xA;// Initiate LoopCounter&#xD;&#xA;LoopCounter = 1;" />
