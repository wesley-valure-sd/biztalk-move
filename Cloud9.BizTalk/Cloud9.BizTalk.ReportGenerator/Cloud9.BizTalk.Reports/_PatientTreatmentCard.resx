  <data name="sdsEntries.SelectCommand" xml:space="preserve">
    <value>	SELECT
		ROW_NUMBER() OVER (ORDER BY tceDateTime) AS [RowNum],
		PersonPatient.persFullName AS [Patient Name],
		Patient.patID AS [Patient ID],
		TreatmentCardEntry.*,
		orgName
	FROM
		TreatmentCardEntry inner join Patient ON TreatmentCardEntry.patGUID = Patient.patGUID
		INNER JOIN Person PersonPatient ON Patient.persGUID = PersonPatient.persGUID
		INNER JOIN Organization ON Organization.orgGUID = TreatmentCardEntry.orgGUID
	WHERE
		TreatmentCardEntry.tceGUID = @tceGUID
		AND tceType != 'R'
	ORDER BY
		tceDateTime
</value>
  </data>
  <data name="sqlDataSourceColumns.SelectCommand" xml:space="preserve">
    <value>SELECT
	ISNULL(tccHeader, '') as tccHeader,
	ISNULL(tccOrder, 999) as tccOrder,
	ISNULL(tccGridWidth, 80) as tccGridWidth,
	tccDatabaseColumn
FROM
	TreatmentCardColumn
WHERE
	tclGUID = (SELECT tclGUID FROM TreatmentCardEntry WHERE tceGUID = @tceGUID)
	AND (tccDeleted is null or tccDeleted = 0)
	AND (tccDatabaseColumn is not null and tccDatabaseColumn != '')
ORDER BY
	tccOrder
</value>
  </data>
